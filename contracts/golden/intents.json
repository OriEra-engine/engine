{
  "comment": "parse 意图词汇单一来源（issue #98；含全角归一/清屏同义词/否定后置不抑制边界）。Rust parse()（crates/oriera-agent/src/lib.rs）与浏览器 kernel parseIntent()（examples/11-ai-cafe/engine/kernel.js）双端共读此文件做镜像断言——改任何一侧的解析行为（加意图、改否定语义、改参数提取）必须同步更新此文件，否则双端 CI 同红。expect.kind 词汇：spawn/clear/gravity/teleport/count/speed/unknown。",
  "cases": [
    { "input": "spawn 40 particles", "expect": { "kind": "spawn", "n": 40 } },
    { "input": "生成 50 个粒子", "expect": { "kind": "spawn", "n": 50 } },
    { "input": "放 20 个", "expect": { "kind": "spawn", "n": 20 } },
    { "input": "生成3个", "expect": { "kind": "spawn", "n": 3 } },
    { "input": "clear the world", "expect": { "kind": "clear" } },
    { "input": "清空", "expect": { "kind": "clear" } },
    { "input": "清屏", "expect": { "kind": "clear" } },
    { "input": "清空，但别关灯", "expect": { "kind": "clear" } },
    { "input": "放５个", "expect": { "kind": "spawn", "n": 5 } },
    { "input": "生成１０个", "expect": { "kind": "spawn", "n": 10 } },
    { "input": "set gravity to 1.6", "expect": { "kind": "gravity", "g": 1.6 } },
    { "input": "set gravity to 10", "expect": { "kind": "gravity", "g": 10 } },
    { "input": "gravity 9.8", "expect": { "kind": "gravity", "g": 9.8 } },
    { "input": "重力 9.8", "expect": { "kind": "gravity", "g": 9.8 } },
    { "input": "重力 9", "expect": { "kind": "gravity", "g": 9 } },
    { "input": "teleport 100 -25", "expect": { "kind": "teleport", "dx": 100, "dy": -25 } },
    { "input": "teleport to 100 200", "expect": { "kind": "teleport", "dx": 100, "dy": 200 } },
    { "input": "传送到 50,-25", "expect": { "kind": "teleport", "dx": 50, "dy": -25 } },
    { "input": "how many", "expect": { "kind": "count" } },
    { "input": "how many entities", "expect": { "kind": "count" } },
    { "input": "现在有多少个", "expect": { "kind": "count" } },
    { "input": "有多少个", "expect": { "kind": "count" } },
    { "input": "speed 2x", "expect": { "kind": "speed", "k": 2 } },
    { "input": "速度 1.5 倍", "expect": { "kind": "speed", "k": 1.5 } },
    { "input": "倍速 0.5", "expect": { "kind": "speed", "k": 0.5 } },
    { "input": "别清空", "expect": { "kind": "unknown", "text": "别清空" } },
    { "input": "不要生成新的", "expect": { "kind": "unknown", "text": "不要生成新的" } },
    { "input": "不要 spawn 5", "expect": { "kind": "unknown", "text": "不要 spawn 5" } },
    { "input": "do not spawn", "expect": { "kind": "unknown", "text": "do not spawn" } },
    { "input": "hello there", "expect": { "kind": "unknown", "text": "hello there" } },
    { "input": "给我讲个故事", "expect": { "kind": "unknown", "text": "给我讲个故事" } },
    { "input": "teleport to the moon", "expect": { "kind": "unknown", "text": "teleport to the moon" } }
  ]
}
